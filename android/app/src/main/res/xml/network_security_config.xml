<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (HTTP) disabled. Trust the system CA store and user-added CAs
     (needed for debug proxies / corporate MITM during development). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
